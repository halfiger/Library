public List<User> findAllSortedByAge() {

    Session session = factory.getCurrentSession();

    session.beginTransaction();

    List<User> users = session
            .createQuery(
                    "FROM User u ORDER BY u.age",
                    User.class
            )
            .getResultList();

    session.getTransaction().commit();

    return users;
}
